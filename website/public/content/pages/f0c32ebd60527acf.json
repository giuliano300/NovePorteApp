{"path":"/Forum/Dettaglio-Forum/Azione-4","title":"Laboratorio della porta dell'Azione","html":"<div class=\"content-page-std2\">\n        <div class=\"container-fluid\">\n            <div class=\"row\">\n                <div class=\"col-lg-2 col-md-2\">\n                    <div class=\"column-left\">\n                        <div id=\"ctl00_ContentPlaceHolder1_BtnPorta\" class=\"btn-porta\">\n                            <a id=\"ctl00_ContentPlaceHolder1_BtnIntrumentum\" href=\"#\">Instrumentum</a>\n                        </div>\n                        <div class=\"menu-forum\">\n                            <ul>\n                                <li id=\"ctl00_ContentPlaceHolder1_Principi\"><a href=\"/Principi\">Principi e Regole</a> <i style=\"color:#4D4D4D; font-size:10px;\" class=\"fa fa-square\" aria-hidden=\"true\"></i></li>\n                                \n                                \n                                \n                                <li id=\"ctl00_ContentPlaceHolder1_LiNuovoContributo\"><a href=\"/NuovoContributo?Id=4\" id=\"ctl00_ContentPlaceHolder1_HrefContributo\">Nuovo Contributo</a> <i style=\"color:#4F9E54; font-size:10px;\" class=\"fa fa-square\" aria-hidden=\"true\"></i></li>\n                            </ul>\n                        </div>\n                        \n\n    <div class=\"ricerca-forum\">\n        <input name=\"ctl00$ContentPlaceHolder1$ControlloRicerca$TxtCerca\" type=\"text\" id=\"ctl00_ContentPlaceHolder1_ControlloRicerca_TxtCerca\">\n        &nbsp;\n        <input type=\"submit\" name=\"ctl00$ContentPlaceHolder1$ControlloRicerca$BtnCerca\" value=\"\" id=\"ctl00_ContentPlaceHolder1_ControlloRicerca_BtnCerca\">\n        \n    </div>\n\n    <div class=\"container-sotto-categorie\">\n        \n                <div class=\"container-link\">\n                    <input type=\"hidden\" name=\"ctl00$ContentPlaceHolder1$ControlloRicerca$LtvSottoCategorie$ctrl0$Hid\" id=\"ctl00_ContentPlaceHolder1_ControlloRicerca_Ltv