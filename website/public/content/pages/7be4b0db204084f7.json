                            \n                                            <input type=\"hidden\" name=\"ctl00$ContentPlaceHolder1$LtvRisposte$ctrl1$HidRisposta\" id=\"ctl00_ContentPlaceHolder1_LtvRisposte_ctrl1_HidRisposta\" value=\"713\">\n                                            <div class=\"list-commenti\">\n                                                <h2>Giovanni Martino</h2>\n                                                <article>\n                                                    <div class=\"row\">\n                                                        \n                                                        <div id=\"ctl00_ContentPlaceHolder1_LtvRisposte_ctrl1_DivRisposta\" class=\"col-lg-12\">\n                                                            <h4 class=\"hidden\"><span id=\"ctl00_ContentPlaceHolder1_LtvRisposte_ctrl1_LblTitoloRisposta\"></span></h4>\n                                                            <span id=\"ctl00_ContentPlaceHolder1_LtvRisposte_ctrl1_LblDescrizioneRisposta\"><p>Egregio signor Impeciati,</p><p>alcuni Cavalieri romani frequentano a Roma il laboratorio di Alberto Pieri, in piazza Armenia, 6.</p><p>Cavallereschi saluti</p><p>Giovanni Martino</p></span>\n                                                            <h6><span id=\"ctl00_ContentPlaceHolder1_LtvRisposte_ctrl1_LblData\">da Roma, lunedì 3 aprile 2023 alle ore 08:45:05</span></h6>\n                                                        </div>\n                                                    </div>\n                                                </article>\n                                                <a class=\"Risposta\" id=\"Risposta-713\">INTERVENGA</a>\n                                                <div class=\"row\">\n                                                    <div class=\"col-lg-12\">\n                                                        <div class=\"form-add-risposta\" id=\"form-add-risposta-713\">\n                    