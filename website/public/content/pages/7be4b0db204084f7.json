laceHolder1_ControlloRicerca_LtvSottoCategorie_ctrl13_Hid\" value=\"58\">\n                    <a id=\"ctl00_ContentPlaceHolder1_ControlloRicerca_LtvSottoCategorie_ctrl13_LnkSottoCategoria\" href=\"#\">Scarpe</a>\n                                    \n                </div>\n            \n                <div class=\"container-link\">\n                    <input type=\"hidden\" name=\"ctl00$ContentPlaceHolder1$ControlloRicerca$LtvSottoCategorie$ctrl14$Hid\" id=\"ctl00_ContentPlaceHolder1_ControlloRicerca_LtvSottoCategorie_ctrl14_Hid\" value=\"57\">\n                    <a id=\"ctl00_ContentPlaceHolder1_ControlloRicerca_LtvSottoCategorie_ctrl14_LnkSottoCategoria\" href=\"#\">Soprabiti</a>\n                                    \n                </div>\n            \n                <div class=\"container-link\">\n                    <input type=\"hidden\" name=\"ctl00$ContentPlaceHolder1$ControlloRicerca$LtvSottoCategorie$ctrl15$Hid\" id=\"ctl00_ContentPlaceHolder1_ControlloRicerca_LtvSottoCategorie_ctrl15_Hid\" value=\"56\">\n                    <a id=\"ctl00_ContentPlaceHolder1_ControlloRicerca_LtvSottoCategorie_ctrl15_LnkSottoCategoria\" href=\"#\">Giacche</a>\n                                    \n                </div>\n            \n                <div class=\"container-link\">\n                    <input type=\"hidden\" name=\"ctl00$ContentPlaceHolder1$ControlloRicerca$LtvSottoCategorie$ctrl16$Hid\" id=\"ctl00_ContentPlaceHolder1_ControlloRicerca_LtvSottoCategorie_ctrl16_Hid\" value=\"55\">\n                    <a id=\"ctl00_ContentPlaceHolder1_ControlloRicerca_LtvSottoCategorie_ctrl16_LnkSottoCategoria\" href=\"#\">Abiti</a>\n                                    \n                </div>\n            \n                <div class=\"container-link\">\n                    <input type=\"hidden\" name=\"ctl00$ContentPlaceHolder1$ControlloRicerca$LtvSottoCategorie$ctrl17$Hid\" id=\"ctl00_ContentPlaceHolder1_ControlloRicerca_LtvSottoCategorie_ctrl17_Hid\" value=\"54\">\n                    <a id=\"ctl00_ContentPlaceHolder1_ControlloRicerca_LtvSottoCategorie_ctrl17_LnkSottoCategoria\" href=\"#\">Teoria e Storia dell'Abbigliamento classico</a>\n                                    \n                </div>\n            \n    </div>\n                    </div>\n                </div>\n\n                <div class=\"col-lg-8 col-md-8\">\n                    <div class=\"contain-forum\">\n\n                        <div class=\"contain-form-det\">\n                            <div class=\"row\">\n                                <div class=\"col-lg-6 col-md-6\">\n                                    <h1>Camicia a Roma</h1>\n                                    <h2>Camicie </h2>\n                                </div>\n                                <div class=\"col-lg-6 col-md-6\">\n                                   <a id=\"ctl00_ContentPlaceHolder1_LnkBack\" href=\"#\">TORNI A ABBIGLIAMENTO</a>\n                                </div>\n                                <div class=\"col-lg-12\">\n                                    <div class=\"relatore\">\n                                        <h3>Massimo Impeciati</h3>\n                                        <h4>da Roma, venerdì 31 marzo 2023 alle ore 00:33:35</h4>\n                                    </div>\n                                </div>\n                                <div class=\"col-lg-12 col-md-12 col-sm-12\">\n                                    <div class=\"row\">\n                                        <div class=\"dettaglio-articolo\">\n                                            <div id=\"ctl00_ContentPlaceHolder1_DivImg\" class=\"col-lg-3\">\n                                                <div class=\"img-articolo-det\">\n                                                    <a href=\"/Public/FileUpload/638158196153662517DSC04335.JPG\" id=\"ctl00_ContentPlaceHolder1_Href\" class=\"fancybox\"><img id=\"ctl00_ContentPlaceHolder1_ImgArticolo\" src=\"https://noveporte.it/Public/FileUpload/638158196153662517DSC04335.JPG\"></a>\n                                                </div>\n                                            \n                                            </div>\n                                            <div id=\"ctl00_ContentPlaceHolder1_DivDescrizione\" class=\"col-lg-9\">\n                                                <p>Carissimi Cavalieri, mi ritrovo a Roma non più in grado di raggiungere la mia affezionata signora Sabatini, abile come nessuna nel confezionamento delle camicie. Ho provato a ricontattarla ai vecchi numeri senza alcun successo. Avete notizie di lei ? Sapete se ancora è attiva nella produzione di camicie?&nbsp;</p>\n<p>In caso di esito negativo, saranno apprezzati vostri suggerimenti su eventuali nuovi fornitori di camicie su misura ai quali già vi rivolgete.</p>\n<p>un particolare ringraziamento&nbsp;</p>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n\n                        <div class=\"commenti-forum\">\n                            <div class=\"add-commento\">\n                                <div class=\"row\">\n                                    <div class=\"col-lg-12\">\n                                        <div class=\"row\">\n                                            <div class=\"col-lg-12\">\n                                                <a id=\"ctl00_ContentPlaceHolder1_HrefRisposte\" name=\"Risposte\" class=\"Risposte\">Intervenga</a>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"row\">\n                                    <div class=\"col-lg-8 col-lg-offset-2 col-md-8 col-md-offset-2 col-sm-8 col-sm-offset-2\">\n                                        <div class=\"form-add-intervento\">\n                                            <p>\n                                                <input name=\"ctl00$ContentPlaceHolder1$TxtNome\" type=\"text\" id=\"ctl00_ContentPlaceHolder1_TxtNome\" placeholder=\"Inserisca il suo nome\">\n                                                &nbsp;\n                                            </p>\n                                            <p>\n                                                <input name=\"ctl00$ContentPlaceHolder1$TxtCognome\" type=\"text\" id=\"ctl00_ContentPlaceHolder1_TxtCognome\" placeholder=\"Inserisca il suo cognome\">\n                                                &nbsp;\n                                            </p>\n                                            <p class=\"full-width\">\n                                                <input name=\"ctl00$ContentPlaceHolder1$TxtEmail\" type=\"text\" id=\"ctl00_ContentPlaceHolder1_TxtEmail\" placeholder=\"Inserisca la sua email\">\n                                                &nbsp;\n                                            </p>\n                                            <p class=\"full-width\">\n                                                <input name=\"ctl00$ContentPlaceHolder1$TxtCitta\" type=\"text\" id=\"ctl00_ContentPlaceHolder1_TxtCitta\" placeholder=\"Inserisca la città\">\n                                                &nbsp;\n                                            </p>\n                                            \n                                            <p class=\"full-width\">\n                                                <span style=\"color:#b90000; font-size:14px;\"><strong>Avvertenza:</strong> <br>\n                                                Volendo aggiungere immagini interne all’intervento, cliccare Invio due volte prima e dopo averle inserite. \n                                                <br>Solo così appariranno ben distanziate dal testo e tra loro.<br><br></span>\n                                                <textarea name=\"ctl00$ContentPlaceHolder1$TxtMessaggio\" rows=\"2\" cols=\"20\" id=\"ctl00_ContentPlaceHolder1_TxtMessaggio\" class=\"summernote\" placeholder=\"Inserisca il messaggio\"></textarea>\n                                                &nbsp;\n                                            </p>\n                                            <p class=\"full-width\">\n                                                </p><h4>Selezioni l'immagine di anteprima</h4>\n                                                <input type=\"file\" name=\"ctl00$ContentPlaceHolder1$FupImmagine\" id=\"ctl00_ContentPlaceHolder1_FupImmagine\">\n                                            <p></p>\n                                            <p class=\"full-width\">\n                                                <a id=\"ctl00_ContentPlaceHolder1_LnkInsert\" href=\"#\">INVIO</a>\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"row\">\n                                <div class=\"col-lg-12 padding-25\">\n                                    \n                                            <input type=\"hidden\" name=\"ctl00$ContentPlaceHolder1$LtvRisposte$ctrl0$HidRisposta\" id=\"ctl00_ContentPlaceHolder1_LtvRisposte_ctrl0_HidRisposta\" value=\"708\">\n                                            <div class=\"list-commenti\">\n                                                <h2>Giancarlo Maresca</h2>\n                                                <article>\n                                                    <div class=\"row\">\n                                                        \n                                                        <div id=\"ctl00_ContentPlaceHolder1_LtvRisposte_ctrl0_DivRisposta\" class=\"col-lg-12\">\n                                                            <h4 class=\"hidden\"><span id=\"ctl00_ContentPlaceHolder1_LtvRisposte_ctrl0_LblTitoloRisposta\"></span></h4>\n                                                            <span id=\"ctl00_ContentPlaceHolder1_LtvRisposte_ctrl0_LblDescrizioneRisposta\"><p>Egregio signor Impeciati,<br>la Sabatini è stata per un quarto di secolo una Fornitrice Ufficiale dell'Ordine. Negli ultimi anni si era ritirata in casa e serviva sporadicamente solo qualche irriducibile amico che l'andava a trovare. Ora si è ritirata del tutto, non a causa delle proprie condizioni quanto per stare vicino al marito. Per rispondere dunque alla sua domanda, posso dirle che non siamo orfani della signora Sabatini ma delle sue camicie sì. A Roma non saprei dove altro indirizzarla. Dopo trent'anni in cui mi sono servito quasi ininterrottamente dalla Sabatini, ho trovato un giovane camiciaio napoletano che sta crescendo bene e ancora pratica prezzi acconci. Si tratta di Alberto Nolano, Corso Amedeo di Savoia n. 256.<br><br>Cavallereschi saluti<br>Giancarlo Maresca</p></span>\n                                                            <h6><span id=\"ctl00_ContentPlaceHolder1_LtvRisposte_ctrl0_LblData\">da Napoli, martedì 28 marzo 2023 alle ore 20:18:16</span></h6>\n                                                        </div>\n                                                    </div>\n                                                </article>\n                                                <a class=\"Risposta\" id=\"Risposta-708\">INTERVENGA</a>\n                                                <div class=\"row\">\n                                                    <div class=\"col-lg-12\">\n                                                        <div class=\"form-add-risposta\" id=\"form-add-risposta-708\">\n                                                            <p>\n                                                                <input name=\"ctl00$ContentPlaceHolder1$LtvRisposte$ctrl0$TxtNomeRisposta\" type=\"text\" id=\"ctl00_ContentPlaceHolder1_LtvRisposte_ctrl0_TxtNomeRisposta\" title=\"Nome-<%# Eval(&quot;Id&quot;) %>\" placeholder=\"Inserisca il suo nome\">\n                                                                &nbsp;\n                                                            </p>\n                                                            <p>\n                                                                <input name=\"ctl00$ContentPlaceHolder1$LtvRisposte$ctrl0$TxtCognomeRisposta\" type=\"text\" id=\"ctl00_ContentPlaceHolder1_LtvRisposte_ctrl0_TxtCognomeRisposta\" placeholder=\"Inserisca il suo cognome\">\n                                                                &nbsp;\n                                                            </p>\n                                                            <p class=\"full-width\">\n                                                                <input name=\"ctl00$ContentPlaceHolder1$LtvRisposte$ctrl0$TxtEmailRisposta\" type=\"text\" id=\"ctl00_ContentPlaceHolder1_LtvRisposte_ctrl0_TxtEmailRisposta\" placeholder=\"Inserisca la sua email\">\n                                                                &nbsp;\n                                                            </p>\n                                                            <p class=\"full-width\">\n                                                                <input name=\"ctl00$ContentPlaceHolder1$LtvRisposte$ctrl0$TxtCittaRisposta\" type=\"text\" id=\"ctl00_ContentPlaceHolder1_LtvRisposte_ctrl0_TxtCittaRisposta\" placeholder=\"Inserisca la città\">\n                                                                &nbsp;\n                                                            </p>\n                                                            <p class=\"full-width\">\n                           