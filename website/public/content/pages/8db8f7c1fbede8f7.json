laceHolder1_TxtMessaggio\" class=\"summernote\" placeholder=\"Inserisca il messaggio\"></textarea>\n                                                &nbsp;\n                                            </p>\n                                            <p class=\"full-width\">\n                                                </p><h4>Selezioni l'immagine di anteprima</h4>\n                                                <input type=\"file\" name=\"ctl00$ContentPlaceHolder1$FupImmagine\" id=\"ctl00_ContentPlaceHolder1_FupImmagine\">\n                                            <p></p>\n                                            <p class=\"full-width\">\n                                                <a id=\"ctl00_ContentPlaceHolder1_LnkInsert\" href=\"#\">INVIO</a>\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"row\">\n                                <div class=\"col-lg-12 padding-25\">\n                                    \n                                </div>\n                            </div>\n                        </div>\n                        \n                    </div>\n                </div>\n\n                <div class=\"col-lg-2 col-md-2\">\n                    \n<link href=\"/Css/Calendar.css\" rel=\"stylesheet\">\n<div class=\"column-right\">\n    <h3>Prossimi Eventi</h3>\n    <div class=\"row\">\n        \n                <div class=\"col-lg-12 col-md-12 col-sm-6 col-xs-12\">\n                    <div class=\"archivio-forum\">\n                        <input type=\"hidden\" name=\"ctl00$ContentPlaceHolder1$ControlloNews$LtvNews$ctrl0$Hid\" id=\"ctl00_ContentPlaceHolder1_ControlloNews_LtvNews_ctrl0_Hid\" value=\"2448\">\n                        <a href=\"/News-page/eventi/Dettaglio-Eventi/Evento/XVI-APA-DELLA-GRANDE-MILANO-2448\" id=\"ctl00