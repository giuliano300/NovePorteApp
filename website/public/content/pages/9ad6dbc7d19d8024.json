{"path":"/Registro.aspx","title":"Registro","html":"<div class=\"content-page-std\">\n        <div class=\"container\">\n            <div class=\"row\">\n                <div class=\"registrati\">\n\n                        <h1 class=\"wowload delay-02 fadeIn\">Registro</h1>\n                        \n                        <section>\n                            <div class=\"col-lg-8 col-lg-offset-2 col-md-8 col-md-offset-8\">\n                                La registrazione non comporta alcun impegno, nè l'assunzione della qualità di socio.\n                                I dati personali resteranno custoditi in una rubrica dei Simpatizzanti e utilizzati dall'Associazione unicamente per la spedizione, lungo un periodo limitato di tempo, di parte della Posta dei Cavalieri.\n                                Non è possibile iscriversi direttamente dal sito. Per qualsiasi chiarimento, commento o critica, scrivete a cavalleresco.ordine@noveporte.it. \n                                Ogni lettera troverà risposta. \n                            </div>\n                        </section>\n                        \n                        <div class=\"col-lg-4 col-lg-offset-2 col-md-2 col-md-offset-2 col-sm-4 col-sm-offset-2\">\n                            <input name=\"ctl00$ContentPlaceHolder1$TxtNome\" type=\"text\" id=\"ctl00_ContentPlaceHolder1_TxtNome\" placeholder=\"Nome\">\n                            &nbsp;\n                        </div>\n                        <div class=\"col-lg-4 col-md-2 col-sm-4\"><input name=\"ctl00$ContentPlaceHolder1$TxtCognome\" type=\"text\" id=\"ctl00_ContentPlaceHolder1_TxtCognome\" placeholder=\"Cognome\">\n                            &nbsp;\n                        </div>\n                        <div class=\"col-lg-4 col-lg-offset-2 col-md-2 col-md-offset-2 col-sm-4 col-sm-offset-2\"><input name=\"ctl00$ContentPlaceHolder1$TxtIndirizzo\" type=\"text\" id=\"ctl00_ContentPlaceHolder1_TxtIndirizzo\" placeholder=\"Indirizzo\">\n                            &nbsp;\n                        </div>\n                        <div class=\"col-lg-4 col-md-2 col-sm-4\"><input name=\"ctl00$ContentPlaceHolder1$TxtCitta\" type=\"text\" id=\"ctl00_ContentPlaceHolder1_TxtCitta\" placeholder=\"Citta\">\n                            &nbsp;\n                        </div>\n                        <div class=\"col-lg-4 col-lg-offset-2 col-md-2 col-md-offset-2 col-sm-4 col-sm-offset-2\"><input name=\"ctl00$ContentPlaceHolder1$TxtEta\" type=\"text\" id=\"ctl00_ContentPlaceHolder1_TxtEta\" placeholder=\"Età\">\n                            &nbsp;\n                        </div>\n                        <div class=\"col-lg-4 col-md-2 col-sm-4\"><input name=\"ctl00$ContentPlaceHolder1$TxtCell\" type=\"tel\" id=\"ctl00_ContentPlaceHolder1_TxtCell\" placeholder=\"Cellulare\">\n                            &nbsp;\n                        </div>\n                        <div class=\"col-lg-8 col-lg-offset-2 col-md-8 col-md-offset-2 col-sm-8 col-sm-offset-2\"><input name=\"ctl00$ContentPlaceHolder1$TxtEmail\" type=\"email\" id=\"ctl00_ContentPlaceHolder1_TxtEmail\" placeholder=\"Email\">\n                            &nbsp;\n                        </div>\n                        <div class=\"col-lg-8 col-lg-offset-2 col-md-8 col-md-offset-2 col-sm-8 col-sm-offset-2\"><textarea name=\"ctl00$ContentPlaceHolder1$TxtInteressi\" rows=\"2\" cols=\"20\" id=\"ctl00_ContentPlaceHolder1_TxtInteressi\" placeholder=\"Interessi\"></textarea></div>\n                        <div class=\"col-lg-8 col-lg-offset-2 col-md-8 col-md-offset-2 col-sm-8 col-sm-offset-2\"><textarea name=\"ctl00$ContentPlaceHolder1$TxtTextReg\" rows=\"2\" cols=\"20\" id=\"ctl00_ContentPlaceHolder1_TxtTextReg\" placeholder=\"Come ha saputo del cavalleresco ordine?\"></textarea></div>\n                        <div class=\"col-lg-10\"><input type=\"submit\" name=\"ctl00$ContentPlaceHolder1$BtnInvia\" value=\"INVIA\" id=\"ctl00_ContentPlaceHolder1_BtnInvia\"></div>\n                        <div class=\"col-lg-12 text-center Error\"></div>\n                </div>\n            </div>\n        </div>\n    </div>"}